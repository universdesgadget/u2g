{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "u2g.vercel.app" }],
      "destination": "https://universdesgadgets.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.universdesgadgets.com" }],
      "destination": "https://universdesgadgets.com/:path*",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/favicon.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Content-Type", "value": "image/x-icon" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
